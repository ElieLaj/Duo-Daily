# --- Discord ---------------------------------------------------------------
# Token du bot : https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=
# Salon ou le resume quotidien est poste (clic droit sur le salon > Copier l'identifiant)
DISCORD_CHANNEL_ID=
# Optionnel : ID du serveur. Si rempli, la commande /resume est dispo instantanement
# au lieu d'attendre jusqu'a 1h de propagation globale.
DISCORD_GUILD_ID=

# --- Riot ------------------------------------------------------------------
# https://developer.riotgames.com  (une cle Development expire toutes les 24h)
RIOT_API_KEY=
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Joueurs suivis, separes par des virgules, au format Pseudo#TAG.
# Les guillemets sont OBLIGATOIRES : sans eux, le "#" du Riot ID est lu comme un
# debut de commentaire et la valeur est tronquee.
PLAYERS="Pseudo#TAG,AutrePseudo#TAG"

# File d'attente suivie : RANKED_SOLO_5x5 ou RANKED_FLEX_SR
QUEUE=RANKED_SOLO_5x5

# --- Rendu -----------------------------------------------------------------
# clean = LP en gros + pastille verte/rouge (barre laterale aux couleurs du rang)
# ansi  = texte reellement colore, mais encadre comme un bloc de code
LP_STYLE=clean
# Embleme de rang : none (defaut) / thumbnail (vignette a droite) / image (pleine largeur)
EMBLEM_STYLE=none

# --- Planification ---------------------------------------------------------
# Heure du resume quotidien (HH:MM, 24h)
DAILY_TIME=23:00
TIMEZONE=Europe/Paris
# Si le PC etait eteint a l'heure prevue, poster le resume manquant au demarrage
CATCH_UP=true

# --- Surveillance des parties ----------------------------------------------
# Annonce chaque partie terminee par un joueur suivi. N'influence jamais le
# point de comparaison du resume quotidien.
LIVE_CHECK=true
LIVE_INTERVAL_MIN=3
# Salon des annonces ; vide = celui du resume quotidien
LIVE_CHANNEL_ID=
# Roles mentionnes quand un joueur monte de rang : noms ou identifiants separes
# par des virgules. Vide = aucune mention.
# Le role doit etre "mentionnable" (Parametres du serveur > Roles), sinon la
# mention s'affiche sans notifier personne.
PROMOTION_ROLE=Goat

# --- Rate limiting Riot ----------------------------------------------------
# Limites affichees sur https://developer.riotgames.com, au format "nb:secondes"
# separees par des virgules. Cle Development = 20 req / 1 s ET 100 req / 120 s.
# Quand tu passeras a une cle Personal, remplace juste ces chiffres.
RIOT_RATE_LIMITS=20:1,100:120
# Marge de securite (0.9 = on ne consomme que 90% du quota annonce)
RIOT_RATE_SAFETY=0.9

# Anciennete minimale, en jours, du pic battu pour annoncer un record.
# 0 (defaut) annonce chaque depassement. Mettre 7 par exemple pour ne retenir
# que le fait de battre un record un peu ancien, et rester silencieux pendant
# une montee continue.
PEAK_ANNOUNCE_DAYS=0

# --- Aperçus ----------------------------------------------------------------
# Salon ou postent npm run preview et npm run preview:live. Aucun repli sur le
# salon principal : sans cette variable, les scripts d'apercu refusent de
# partir, pour ne pas deverser des messages de test devant tout le serveur.
TEST_CHANNEL_ID=
# Serveur ou le mode test enregistre ses commandes. Vide = enregistrement
# global, qui n'ecrase pas celles du serveur reel.
TEST_GUILD_ID=
